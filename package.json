{
  "name": "cedars-os-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "dev:local": "tsx --env-file=.env scripts/dev-server.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "prod:check": "tsx --env-file=.env scripts/prod-check.ts",
    "preview:check": "tsx scripts/preview-check.ts",
    "runtime:check": "tsx scripts/runtime-check.ts",
    "acceptance:check": "node scripts/validate-acceptance-records.mjs",
    "build": "prisma generate && tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "jose": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/node": "^28.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vercel": "^65.4.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
