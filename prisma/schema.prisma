generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  FOUNDER
  INVESTOR
  PARTNER
  FINANCE_ADMIN
  COMPLIANCE_OFFICER
  HEALTHCARE_ADMIN
  EDUCATION_ADMIN
  USER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalDecisionType {
  APPROVE
  REJECT
}

model User {
  id             String      @id @default(uuid()) @db.Uuid
  externalSubject String     @unique @map("external_subject")
  role           Role
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  auditLogs      AuditLog[]
  flagsUpdated   FeatureFlag[]
  workersUpdated WorkerConfig[]
  gridsUpdated   GridConfig[]
  controlScopesUpdated ControlScopeConfig[]
  gridTasksCreated GridTask[] @relation("GridTaskBuyer")
  gridTasksAccepted GridTask[] @relation("GridTaskAcceptedBy")
  approvalRequests ApprovalRequest[] @relation("ApprovalRequester")
  approvalDecisions ApprovalDecision[] @relation("ApprovalReviewer")

  @@map("users")
}

model FeatureFlag {
  id          String    @id @default(uuid()) @db.Uuid
  moduleName  String    @unique @map("module_name") @db.VarChar(100)
  enabled     Boolean   @default(false)
  updatedById String?   @map("updated_by_id") @db.Uuid
  updatedBy   User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model ControlScopeConfig {
  id          String   @id @default(uuid()) @db.Uuid
  scopeType   String   @map("scope_type") @db.VarChar(40)
  scopeId     String   @map("scope_id") @db.VarChar(100)
  enabled     Boolean  @default(false)
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([scopeType, scopeId])
  @@index([scopeType, enabled])
  @@map("control_scope_configs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.VarChar(100)
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model ApprovalRequest {
  id                    String               @id @default(uuid()) @db.Uuid
  scope                 String               @db.VarChar(60)
  entityType            String               @map("entity_type") @db.VarChar(100)
  entityId              String               @map("entity_id") @db.VarChar(100)
  expectedState         Json                 @map("expected_state")
  proposedState         Json                 @map("proposed_state")
  requiredApproverRoles Role[]               @map("required_approver_roles")
  reason                String               @db.VarChar(500)
  status                ApprovalStatus       @default(PENDING)
  version               Int                  @default(0)
  requestedById         String               @map("requested_by_id") @db.Uuid
  requestedByRole       Role                 @map("requested_by_role")
  requestedBy           User                 @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decisions             ApprovalDecision[]
  createdAt             DateTime             @default(now()) @map("created_at")
  resolvedAt            DateTime?            @map("resolved_at")

  @@index([status, createdAt])
  @@index([entityType, entityId, status])
  @@map("approval_requests")
}

model ApprovalDecision {
  id          String               @id @default(uuid()) @db.Uuid
  requestId   String               @map("request_id") @db.Uuid
  request     ApprovalRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewerId  String               @map("reviewer_id") @db.Uuid
  reviewer    User                 @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewerRole Role                @map("reviewer_role")
  decision    ApprovalDecisionType
  reason      String               @db.VarChar(500)
  createdAt   DateTime             @default(now()) @map("created_at")

  @@unique([requestId, reviewerId])
  @@index([reviewerId, createdAt])
  @@map("approval_decisions")
}

model WorkerConfig {
  id               String   @id @db.VarChar(60)
  enabled          Boolean  @default(false)
  desiredInstances Int      @default(1) @map("desired_instances")
  updatedById      String?  @map("updated_by_id") @db.Uuid
  updatedBy        User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("worker_configs")
}

model GridConfig {
  id            String   @id @db.VarChar(60)
  desiredState  String   @default("STANDBY") @map("desired_state") @db.VarChar(20)
  updatedById   String?  @map("updated_by_id") @db.Uuid
  updatedBy     User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("grid_configs")
}

enum GridTaskStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  DELIVERED
  ACCEPTED
  CANCELLED
}

model GridTask {
  id                 String         @id @default(uuid()) @db.Uuid
  buyerId            String         @map("buyer_id") @db.Uuid
  buyer              User           @relation("GridTaskBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  gridId             String         @map("grid_id") @db.VarChar(60)
  workerId           String?        @map("worker_id") @db.VarChar(60)
  title              String         @db.VarChar(160)
  description        String         @db.Text
  acceptanceCriteria String         @map("acceptance_criteria") @db.Text
  agreedAmount       Decimal        @map("agreed_amount") @db.Decimal(20, 8)
  currency           String         @default("USD") @db.VarChar(3)
  status             GridTaskStatus @default(OPEN)
  deliveryEvidence   String?        @map("delivery_evidence") @db.Text
  deliveredAt        DateTime?      @map("delivered_at")
  acceptedById       String?        @map("accepted_by_id") @db.Uuid
  acceptedBy         User?          @relation("GridTaskAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  acceptedAt         DateTime?      @map("accepted_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([buyerId, createdAt])
  @@index([gridId, status, createdAt])
  @@index([workerId, status, createdAt])
  @@map("grid_tasks")
}

model TreasuryTransfer {
  id              String   @id @default(uuid()) @db.Uuid
  chain           String   @db.VarChar(10)
  transactionHash String   @map("transaction_hash") @db.VarChar(128)
  transferIndex   Int      @map("transfer_index")
  blockNumber     BigInt   @map("block_number")
  blockHash       String   @map("block_hash") @db.VarChar(128)
  fromAddress     String   @map("from_address") @db.VarChar(128)
  toAddress       String   @map("to_address") @db.VarChar(128)
  asset           String   @db.VarChar(16)
  amountBaseUnits String   @map("amount_base_units") @db.VarChar(100)
  observedAt      DateTime @default(now()) @map("observed_at")

  @@unique([chain, transactionHash, transferIndex])
  @@index([chain, blockNumber])
  @@index([observedAt])
  @@map("treasury_transfers")
}

model TreasuryCursor {
  chain            String   @id @db.VarChar(10)
  lastScannedBlock BigInt   @map("last_scanned_block")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("treasury_cursors")
}